{
  "name": "ecommerce-server",
  "version": "1.0.0",
  "description": "Professional E-Commerce REST API - Node.js + Express + PostgreSQL + Sequelize MVC",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "migrate": "npx sequelize-cli db:migrate --config src/config/sequelize-cli-config.cjs",
    "migrate:status": "npx sequelize-cli db:migrate:status --config src/config/sequelize-cli-config.cjs",
    "migrate:undo": "npx sequelize-cli db:migrate:undo --config src/config/sequelize-cli-config.cjs",
    "seed:delivery": "npx sequelize-cli db:seed:all --config src/config/sequelize-cli-config.cjs"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express",
    "sequelize",
    "postgresql",
    "mvc"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "sequelize-cli": "^6.6.3"
  }
}
